        <dc:identifier>
            <dcterms:URI>
               <rdf:value>https://gdpr.eu/cookies/</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-03-09 02:05:25</dcterms:dateSubmitted>
        <z:language>en-US</z:language>
    </bib:Document>
